---
import "../styles/global.css"; // optional if it's already globally imported
import Footer from "../components/footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog &amp; Announcements | SplashKit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--  -->
  </head>
  <body class="bg-white text-gray-800 font-['Inter',sans-serif]">
    {/* ========== HEADER ========== */}
    <header class="relative z-50 border-b border-[#ECE9E2]">
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
        <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-288.75"></div>
      </div>

      <nav class="relative mx-auto flex max-w-7xl flex-wrap items-center gap-y-4 px-4 py-5 md:px-6 lg:flex-nowrap lg:px-8">
        {/* Logo */}
        <a class="flex flex-none items-center gap-2 rounded-xl  text-lg font-bold text-[#17181C] focus:outline-hidden focus:opacity-80" href="/" aria-label="SplashKit">
          <img class="h-8 w-8" src="https://splashkit.io/_astro/favicon.ByGd77Wa.svg" alt="" />
          SplashKit
        </a>
        {/* End Logo */}

        {/* Collapse links */}
        <div id="hs-pro-hcail" class="hs-collapse hidden basis-full grow overflow-hidden transition-all duration-300 lg:order-none lg:block lg:w-auto lg:basis-auto lg:grow-0" aria-labelledby="hs-pro-hcail-collapse">
          <div class="mt-5 flex flex-col gap-y-4 lg:mt-0 lg:flex-row lg:items-center lg:justify-center lg:gap-x-8 lg:gap-y-0">
            <a class="relative inline-block text-sm font-medium text-[#17181C] before:absolute before:-bottom-[18px] before:start-0 before:-z-1 before:h-0.5 before:w-full before:bg-yellow-500 focus:outline-hidden" href="/" aria-current="page">Home</a>
            <a class="inline-block text-sm font-medium text-[#17181C] hover:text-gray-500 focus:text-gray-500 focus:outline-hidden" href="/api">Documentation</a>
            <a class="inline-block text-sm font-medium text-[#17181C] hover:text-gray-500 focus:text-gray-500 focus:outline-hidden" href="/guides">Guides</a>
          </div>
        </div>
        {/* End Collapse */}

        {/* Button Group */}
        <div class="ms-auto flex items-center gap-x-2 py-1">
          <a href="https://www.youtube.com/@splashkit7674" type="button" class="relative flex size-9.5 items-center justify-center rounded-xl border border-gray-200 bg-white text-black hover:bg-gray-100 focus:bg-gray-100 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
          </a>
          <a href="https://github.com/splashkit" type="button" class="relative flex size-9.5 items-center justify-center rounded-xl border border-gray-200 bg-white text-black hover:bg-gray-100 focus:bg-gray-100 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
          <a href="/announcements" type="button" class="inline-flex items-center gap-x-2 text-nowrap rounded-full border border-transparent bg-yellow-500 px-4 py-2.5 text-sm text-black transition hover:bg-yellow-400 focus:bg-yellow-500 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50">
            Announcements
          </a>

          <div class="lg:hidden">
            <button type="button" class="hs-collapse-toggle flex size-9.5 items-center justify-center rounded-xl border border-gray-200 text-sm font-semibold text-black hover:bg-gray-100 focus:bg-gray-100 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50" id="hs-pro-hcail-collapse" aria-expanded="false" aria-controls="hs-pro-hcail" aria-label="Toggle navigation" data-hs-collapse="#hs-pro-hcail">
              <svg class="hs-collapse-open:hidden size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="6" y2="6"/><line x1="3" x2="21" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
              <svg class="hs-collapse-open:block hidden size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
        </div>
        {/* End Button Group */}
      </nav>
    </header>
    {/* ========== END HEADER ========== */}

    <main>
      {/* ========== HERO ========== */}
      <section class="px-4 pt-7 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="relative flex h-[70vh] min-h-[420px] flex-col justify-end overflow-hidden rounded-[28px] bg-[#1c1d22] bg-[url('https://i.ibb.co/1t4YGC2g/billboard.png')] bg-cover bg-center bg-no-repeat">
            <div class="absolute inset-0 bg-gradient-to-t from-[#101014] via-[#101014]/55 to-transparent"></div>
            <div class="relative max-w-2xl px-6 pb-10 sm:px-10 sm:pb-14 lg:px-12 lg:pb-16">
              <p class="font-['JetBrains_Mono',monospace] text-xs tracking-widest text-yellow-400">
                // splashkit/blog<span class="animate-pulse motion-reduce:animate-none">_</span>
              </p>
              <h1 class="mt-4  text-3xl leading-[1.05] font-semibold text-white sm:text-5xl lg:text-6xl">
                Welcome to the SplashKit Blog
              </h1>
              <p class="mt-5 max-w-md text-sm text-white/70 sm:text-base">
                SDK updates, website changes, game announcements, and community stories — all in one place.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="#expect" class="inline-flex items-center gap-2 rounded-full bg-yellow-400 px-5 py-2.5 text-sm font-semibold text-[#101014] transition hover:bg-yellow-300 focus:outline-hidden focus:ring-2 focus:ring-yellow-400 focus:ring-offset-2 focus:ring-offset-[#101014]">
                  Explore the blog
                </a>
                <a href="/announcements" class="inline-flex items-center gap-2 rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-hidden focus:ring-2 focus:ring-white/60">
                  View changelog
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      {/* ========== END HERO ========== */}

      {/* ========== WHAT TO EXPECT ========== */}
      <section id="expect" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-medium tracking-widest ">// what's inside</p>
          <h2 class="mt-3  text-3xl font-semibold text-[#17181C] sm:text-4xl">What you can expect</h2>
          <p class="mt-4 text-base text-gray-600">
            We are thrilled to introduce the SplashKit Blog, your go-to space for all things SplashKit! Whether
            you're dipping into game development for the first time, sharpening your coding skills, or just love
            following open source projects, this blog has something for you.
          </p>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2">
          <div class="group rounded-2xl border border-[#ECE9E2] bg-[#FBFAF7] p-7 transition hover:-translate-y-1 hover:border-yellow-400/60 hover:shadow-[0_20px_40px_-28px_rgba(23,24,28,0.4)]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-yellow-400">upd</span>
            <h3 class="mt-5  text-lg font-semibold text-[#17181C]">News and Updates</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Get the inside scoop on what the SplashKit team is working on — new features, SDK updates, and
              projects in development.
            </p>
          </div>

          <div class="group rounded-2xl border border-[#ECE9E2] bg-[#FBFAF7] p-7 transition hover:-translate-y-1 hover:border-yellow-400/60 hover:shadow-[0_20px_40px_-28px_rgba(23,24,28,0.4)]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-yellow-400">web</span>
            <h3 class="mt-5  text-lg font-semibold text-[#17181C]">Website Improvements</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              As the SplashKit website evolves, we'll share details on new sections, improved usability, and
              other enhancements.
            </p>
          </div>

          <div class="group rounded-2xl border border-[#ECE9E2] bg-[#FBFAF7] p-7 transition hover:-translate-y-1 hover:border-yellow-400/60 hover:shadow-[0_20px_40px_-28px_rgba(23,24,28,0.4)]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-yellow-400">dev</span>
            <h3 class="mt-5 text-lg font-semibold text-[#17181C]">Game Announcements</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              We're not just about tools — we're about fun. Follow new games, updates to favourites, and how
              they're built.
            </p>
          </div>

          <div class="group rounded-2xl border border-[#ECE9E2] bg-[#FBFAF7] p-7 transition hover:-translate-y-1 hover:border-yellow-400/60 hover:shadow-[0_20px_40px_-28px_rgba(23,24,28,0.4)]">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#17181C] font-['JetBrains_Mono',monospace] text-[11px] font-semibold tracking-wide text-yellow-400">oss</span>
            <h3 class="mt-5  text-lg font-semibold text-[#17181C]">Community Contributions</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              SplashKit thrives on collaboration. We'll highlight the ways you can get involved and contribute
              to the project.
            </p>
          </div>
        </div>
      </section>
      {/* ========== END WHAT TO EXPECT ========== */}

      {/* ========== CONTRIBUTE CTA ========== */}
      <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-[28px] bg-[#101014] px-6 py-14 sm:px-14 sm:py-16">
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.15]"
            style="background-image: radial-gradient(circle at 1px 1px, #ffffff 1px, transparent 0); background-size: 22px 22px;"
          ></div>
          <div class="relative mx-auto max-w-2xl text-center">
            <p class="font-['JetBrains_Mono',monospace] text-xs tracking-widest text-[#00ACC1]">// get involved</p>
            <h2 class="mt-3  text-3xl font-semibold text-white sm:text-4xl">Want to contribute?</h2>
            <p class="mt-4 text-sm text-white/70 sm:text-base">
              If you're as excited about SplashKit as we are, there's a place for you — from coding and testing
              to writing tutorials or suggesting new ideas. Together we can make SplashKit even better.
            </p>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <a
                href="https://github.com/splashkit"
                class="inline-flex items-center gap-2 rounded-full bg-[#00ACC1] px-5 py-2.5 text-sm font-semibold text-[#101014] transition hover:bg-yellow-300 focus:outline-hidden focus:ring-2 focus:ring-yellow-400 focus:ring-offset-2 focus:ring-offset-[#101014]"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                View on GitHub
              </a>
              <a href="/guides" class="inline-flex items-center gap-2 rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-hidden focus:ring-2 focus:ring-white/60">
                Explore the docs
              </a>
            </div>
          </div>
        </div>
      </section>
      {/* ========== END CONTRIBUTE CTA ========== */}
    </main>

    <Footer />
  </body>
</html>